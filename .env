# Description: Single source of truth for dev-only, non-secret values shared across
#   scripts/deploy-and-run/docker-compose*.yml, scripts/sonar/docker-compose.sonar.yml,
#   scripts/deploy-and-run/run.sh, scripts/deploy-and-run/reset.sh, playwright/run.sh,
#   scripts/utils/project-label.sh, marketplace-app/src/main/resources/application-dev.yml, and
#   integration-tests' Testcontainers-based repository tests (AbstractPostgresIntegrationTest).
# Usage: Docker Compose reads it from its project directory (the repo root, via --project-directory;
#   scripts/sonar/run.sh passes PROJECT_LABEL from the shell instead); run.sh and playwright/run.sh
#   parse it line by line; integration-tests read it through SharedEnvConfig; application-dev.yml
#   reads the values as ${VAR:default} placeholders.
# Env: None -- this file is itself the environment variable source.
POSTGRES_IMAGE=postgres:18-alpine
# Label of every container the project starts; scripts/docker-clean.sh selects by it.
PROJECT_LABEL=org.ost.project=advertisement
DB_NAME=experiments
DB_USER=experiments_user
DB_PASSWORD=experiments_user_password
DB_PORT=5432
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_BUCKET=advertisement
S3_REGION=us-east-1
S3_PORT=9000
# Account that automation registers first after a database reset; it becomes ADMIN. Development values only.
ADMIN_EMAIL=admin.en@example.com
ADMIN_PASSWORD=password
# Worker processes of the Playwright e2e suite; the measured best on a 4-core machine is 2, raise it on a bigger one.
PW_WORKERS=2
# Highest ESLint warning count the Playwright lint run accepts; lower it whenever raw locators are replaced, never raise it.
PW_LINT_MAX_WARNINGS=875
