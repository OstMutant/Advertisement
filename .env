# Description: Single source of truth for dev-only, non-secret values shared across
#   scripts/deploy-and-run/docker-compose*.yml, scripts/deploy-and-run.sh,
#   scripts/deploy-and-run/reset.sh, marketplace-app/application-dev.yml, and integration-tests'
#   Testcontainers-based repository tests (AbstractPostgresIntegrationTest).
# Usage: read automatically by Docker Compose from the current working directory; other consumers
#   read it via their own shell/YAML `${VAR}` substitution.
# Env: N/A -- this file is itself the environment variable source.
POSTGRES_IMAGE=postgres:15-alpine
DB_NAME=experiments
DB_USER=experiments_user
DB_PASSWORD=experiments_user_password
DB_PORT=5432
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_BUCKET=advertisement
S3_REGION=us-east-1
S3_PORT=9000
