{
  "info": {
    "name": "Marketplace REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Register user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"registered, or already exists on a repeat run\", function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"userId\", pm.response.json().id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/users",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bruno Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Issue API key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"key issued\", function () {",
              "  pm.expect(pm.response.json().rawKey).to.be.a(\"string\");",
              "});",
              "pm.collectionVariables.set(\"apiKey\", pm.response.json().rawKey);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/api-keys",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "api-keys"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{email}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "03 Create advertisement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"created\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"advertisementId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/advertisements",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "advertisements"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Plumbing services\",\n  \"description\": \"Fast and reliable plumbing\",\n  \"adKind\": \"OFFER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "04 List advertisements",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ok\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/advertisements",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "advertisements"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "05 Get advertisement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ok\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/advertisements/{{advertisementId}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "advertisements",
            "{{advertisementId}}"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "06 List taxons",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ok\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/taxons",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "taxons"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "07 Get my settings",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ok\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/users/me/settings",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            "settings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "08 List my API keys",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ok\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/api-keys",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "api-keys"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8081"
    },
    {
      "key": "email",
      "value": "bruno.tester@example.com"
    },
    {
