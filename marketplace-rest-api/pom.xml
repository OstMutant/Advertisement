<?xml version="1.0" encoding="UTF-8"?>
<!-- Description: external, non-Vaadin REST API adapter over marketplace-orchestrator. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.ost</groupId>
        <artifactId>advertisement-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>marketplace-rest-api</artifactId>
    <name>Marketplace Rest Api</name>
    <description>External REST API adapter — non-Vaadin HTTP delivery channel over marketplace-orchestrator, sibling to marketplace-app</description>

    <properties>
        <architecture.boundedContext>rest-api</architecture.boundedContext>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ost</groupId>
            <artifactId>platform-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ost</groupId>
            <artifactId>marketplace-orchestrator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Generates the OpenAPI 3 spec from these controllers/DTOs and serves Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jetbrains-annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Packs the dev-only flow runner page and its Postman collection so DevToolsConfig can serve them from the classpath -->
            <resource>
                <directory>../docs/api-collections/flow-runner/page</directory>
                <targetPath>dev-tools/api-flows</targetPath>
            </resource>
            <resource>
                <directory>../docs/api-collections/postman</directory>
                <targetPath>dev-tools/api-flows/postman</targetPath>
                <excludes>
                    <exclude>README.md</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

</project>
