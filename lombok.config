# Description: Reactor-wide Lombok configuration -- disables annotation "bubbling" to parent
#   directories (config.stopBubbling) and extends @Builder/@Value's copyable-annotations set to
#   include Spring's @Qualifier, so it propagates onto builder-generated constructors/fields.
# Usage: read automatically by the Lombok annotation processor at compile time for every module --
#   no per-module lombok.config overrides this one.
# Env: None.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier