<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-advertisement-schema" author="ostap">
        <validCheckSum>ANY</validCheckSum>

        <!-- ── advertisement ───────────────────────────────────────────────── -->
        <createTable tableName="advertisement"
                      remarks="No FK to user_information -- purge-safety enforced at the application level via AdvertisementPort.findOwnerIds()/clearActorReferences(). Supports soft-delete: deleted_at IS NULL identifies active records. No denormalized attachment columns -- media summaries computed at read time via AttachmentPort.getMediaSummaries().">
            <column name="id" type="BIGSERIAL" remarks="Auto-increment">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)" remarks="Advertisement title">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(20000)" remarks="Full description (nullable, sanitized HTML)"/>
            <column name="ad_kind" type="VARCHAR(20)" defaultValue="OFFER" remarks="OFFER / REQUEST / PRODUCT (AdKind)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT" remarks="Creator (no _user_id suffix); deliberately decoupled. References user_information(id), no FK">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="BIGINT" remarks="Last editor. References user_information(id), no FK"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" remarks="Last modification time"/>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE" remarks="Soft-delete timestamp (NULL = active)"/>
            <column name="deleted_by" type="BIGINT" remarks="Who soft-deleted. References user_information(id), no FK"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0" remarks="Optimistic-lock counter (@Version, checked natively via CrudRepository.save())">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_advertisement_title" tableName="advertisement">
            <column name="title"/>
        </createIndex>
        <createIndex indexName="idx_advertisement_created_at" tableName="advertisement">
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_advertisement_created_by" tableName="advertisement">
            <column name="created_by"/>
        </createIndex>
        <createIndex indexName="idx_advertisement_deleted_at" tableName="advertisement">
            <column name="deleted_at"/>
        </createIndex>
        <createIndex indexName="idx_advertisement_ad_kind" tableName="advertisement">
            <column name="ad_kind"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
